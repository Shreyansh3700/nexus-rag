# Copy to .env and fill in the secrets. docker-compose overrides the *_HOST /
# *_ENDPOINT values with container names, so these defaults suit local dev.

# --- Required secrets ---
OPENAI_API_KEY=replace-with-your-openai-api-key
JWT_SECRET=replace-with-a-long-random-string
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
PASSWORD_HASH_ITERATIONS=210000

# Origin the React frontend is served from — required for browser CORS.
FRONTEND_ORIGIN=http://localhost:5173

# --- LLM ---
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.6
LLM_MAX_TOKENS=6000
# LLM_FALLBACK_CHAIN=openai:gpt-4o-mini,openai:gpt-4o

# --- Embeddings (every model in the chain must output EMBEDDING_DIM) ---
EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_FALLBACK_CHAIN=openai:text-embedding-3-small
EMBEDDING_DIM=1536

# --- PostgreSQL ---
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=nexus_rag
PG_USER=postgres
PG_PASSWORD=postgres
DB_POOL_SIZE=10
MAX_CHAT_TOKENS=2500

# --- Milvus ---
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION_NAME=doc_chunks
MILVUS_TOP_K=5
MILVUS_HYBRID_CANDIDATE_K=20
MILVUS_RRF_K=60
MILVUS_TOKEN=root:Milvus
RETRIEVAL_MAX_COSINE_DISTANCE=0.6

# --- Cross-encoder reranker ---
RERANKER_ENABLED=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
RERANKER_CANDIDATE_K=30
RERANKER_TOP_K=5
RERANKER_MAX_LENGTH=512

# --- MinIO ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=documents
MINIO_SECURE=false

# --- Uploads ---
# Largest accepted file, in bytes (default 25 MB).
MAX_UPLOAD_BYTES=26214400

# --- Redis / ARQ ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
ARQ_MAX_JOBS=5
ARQ_JOB_TIMEOUT=600
ARQ_MAX_TRIES=3

LOG_LEVEL=INFO
